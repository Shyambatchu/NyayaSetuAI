# Application
APP_ENV=development
APP_NAME=VidhiVerse AI
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Database (single SQLite file, no server/Docker; path is relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///../storage/vidhiverse.db

# Authentication
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
GUEST_EXPIRY_DAYS=30
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# LLM (provider-independent; "mock" needs no key)
# Decided 2026-11-17 (D-01): Gemini free tier as primary, Groq as fallback for a second
# key/rate-limit path on demo day. Groq speaks the OpenAI-compatible API, hence
# LLM_FALLBACK_PROVIDER=openai_compatible with Groq's base URL, not a "groq" provider value.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_FALLBACK_PROVIDER=openai_compatible
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_DATA_POLICY=may_train
LLM_ALLOW_USER_DOCUMENTS=false

# Embeddings ("hash" = deterministic test embedder, "local" = multilingual-e5-small)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
RAG_MIN_SIMILARITY=0.78

# Language
ENABLED_LANGUAGES=en

# SerpApi (off: no credits consumed)
SERPAPI_ENABLED=false
SERPAPI_API_KEY=

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=../storage
